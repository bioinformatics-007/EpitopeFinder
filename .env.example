# ==============================================================================
# EpitopeFinder — Production Environment Variables
# ==============================================================================
# Copy this file to '.env' before deploying:
#   cp .env.example .env
#
# Then fill in your real domain name below.
# The deploy/setup.sh script does this automatically.
# ==============================================================================

# ── Your Domain ───────────────────────────────────────────────────────────────
# Replace 'yourdomain.com' with your actual purchased domain.
# This is used for CORS, SSL, and the frontend API URL.
NEXT_PUBLIC_API_URL=https://yourdomain.com

# ── Backend FastAPI ────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# Comma-separated list of allowed CORS origins.
# In production, set ONLY your domain — never use '*'.
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ── Celery / Redis (Docker internal networking) ────────────────────────────────
# Inside Docker Compose, services talk to each other by service name.
# The Redis service is named 'redis' in docker-compose.yml.
# DO NOT use 'localhost' here — it won't resolve inside containers.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── Frontend / Next.js ─────────────────────────────────────────────────────────
NODE_ENV=production
